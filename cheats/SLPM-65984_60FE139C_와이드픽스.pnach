patch=0,EE,0026EF40,extended,8D // DrawRadarMask (disc) A           : width 94.0 -> 70.5
patch=0,EE,0026F070,extended,8D // DrawRadarMask (disc) B           : width 94.0 -> 70.5
patch=0,EE,0026F158,extended,8D // DrawRadarMask (disc) C           : width 94.0 -> 70.5
patch=0,EE,0026B0AC,extended,82 // TransformRadarPointToScreenSpace : centreX 87.0 -> 65.0
