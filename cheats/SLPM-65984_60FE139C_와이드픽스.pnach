patch=0,EE,0026E8B4,extended,82 // DrawRadarSection#2 (map tiles)   : centreX 87.0 -> 65.0
patch=0,EE,0026EF50,extended,82 // DrawRadarMask (disc) A           : centreX 87.0 -> 65.0
patch=0,EE,0026F07C,extended,82 // DrawRadarMask (disc) B           : centreX 87.0 -> 65.0
patch=0,EE,0026F174,extended,82 // DrawRadarMask (disc) C           : centreX 87.0 -> 65.0
